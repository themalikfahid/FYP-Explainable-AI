# Copy to .env and fill in. Never commit or share a real .env file.
# APP_ENV: development | test | production
APP_ENV=development
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
# DATABASE_URL=sqlite:///C:/path/to/project/data/app.db   (default: data/app.db in the project)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGIN_RATE_LIMIT_PER_MINUTE=10
PREDICT_RATE_LIMIT_PER_MINUTE=30
APP_PUBLIC_URL=http://localhost:8000

# Email alerts: disabled | file | smtp
EMAIL_MODE=disabled
# EMAIL_OUTBOX_DIR=artifacts/qa/email_outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=10
